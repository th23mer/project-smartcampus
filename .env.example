# SmartCampus AI : variables d'environnement (MODÈLE).
# Copier en .env (jamais commité) puis remplacer TOUTES les valeurs « change_me ».
#   cp .env.example .env
# Les mots de passe apparaissent aussi dans les URL : utiliser des caractères alphanumériques
# (sinon les encoder en %XX dans les URL) et garder les deux endroits cohérents.

# --- PostgreSQL (SA-16) : conteneurs Docker -----------------------------------------------
# Superutilisateur d'administration : init des conteneurs et maintenance seulement, JAMAIS l'appli.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=smartcampus
POSTGRES_TEST_DB=smartcampus_test

# Ports publiés sur la machine hôte (changer si un PostgreSQL local occupe déjà 5432).
DB_HOST_PORT=5432
DB_TEST_HOST_PORT=5433

# Mots de passe des trois rôles (créés par infra/db/init/01-roles.sh, identiques sur db et db-test).
SMARTCAMPUS_OWNER_PASSWORD=change_me_owner
SMARTCAMPUS_APP_PASSWORD=change_me_app
SMARTCAMPUS_RAG_READER_PASSWORD=change_me_rag

# --- URL de connexion lues par le backend (SA-7, backend/app/core/db.py) -------------------
# Rôle applicatif, DML seulement, driver async (SQLAlchemy 2 + asyncpg).
DATABASE_URL=postgresql+asyncpg://smartcampus_app:change_me_app@localhost:5432/smartcampus
# Rôle propriétaire, DDL, Alembic en synchrone (psycopg 3). Ne jamais le donner à l'appli.
MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5432/smartcampus
# Rôle lecture seule de l'outil RAG search_documents (E4), vue v_searchable_chunk uniquement.
RAG_READER_DATABASE_URL=postgresql+asyncpg://smartcampus_rag_reader:change_me_rag@localhost:5432/smartcampus

# Équivalents pour la base de test (service db-test, port 5433, données en mémoire).
TEST_DATABASE_URL=postgresql+asyncpg://smartcampus_app:change_me_app@localhost:5433/smartcampus_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5433/smartcampus_test
TEST_RAG_READER_DATABASE_URL=postgresql+asyncpg://smartcampus_rag_reader:change_me_rag@localhost:5433/smartcampus_test
# Dans un conteneur du même compose (SA-9), remplacer localhost:5432 par db:5432
# et localhost:5433 par db-test:5432.

# --- Environnement de développement Docker Compose (SA-9) ----------------------------------
# Ports publiés sur la machine hôte (127.0.0.1 seulement). Valeurs standard : ne les changer
# QUE dans votre .env local si un port est déjà pris (ex. FRONTEND_HOST_PORT=3100).
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
# Services optionnels (profils désactivés par défaut).
SEAWEEDFS_S3_HOST_PORT=9000
MLFLOW_HOST_PORT=5000

# Backend dans le conteneur (les URL de base y sont construites avec db:5432, voir docker-compose.yml).
APP_ENV=dev
LOG_LEVEL=INFO
# Secret de signature des jetons d'accès JWT (SA-28) : 32 caractères minimum, jamais commité.
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_jwt_secret_at_least_32_characters
MAIL_FROM=no-reply@smartcampus.example

# Frontend (variables PUBLIQUES, visibles dans le navigateur : aucun secret).
# Lues au BUILD (`next build`, arguments de build) et au démarrage de `next dev`.
# L'URL de l'API est celle vue par le NAVIGATEUR. Laissée vide, elle vaut
# http://localhost:<BACKEND_HOST_PORT> (calculée par docker-compose.yml).
# Après modification : make build && make up.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=dev
# false (défaut) : le chat appelle l'API (session visiteur, conversation, E3) ;
# true : faux flux SSE local (démonstration de l'interface E4 sans backend).
NEXT_PUBLIC_CHAT_MOCK=false
