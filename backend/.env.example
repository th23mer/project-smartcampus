# Variables d'environnement du backend (SA-7). AUCUNE valeur réelle ici (mots de passe factices).
#
# Le backend lit, dans cet ordre (le dernier l'emporte) :
#   1. le `.env` de la RACINE du dépôt (créé depuis `../.env.example`, partagé avec Docker
#      Compose, SA-16) : c'est normalement le seul fichier nécessaire ;
#   2. `backend/.env` (facultatif, copie de ce fichier) pour surcharger localement ;
#   3. les variables d'environnement du processus (priorité maximale).

# dev | test | staging | prod. L'authentification simulée (en-têtes X-Dev-*) n'est active
# qu'en dev et test.
APP_ENV=dev

# Rôle applicatif (DML seulement), pilote async asyncpg.
DATABASE_URL=postgresql+asyncpg://smartcampus_app:change_me_app@localhost:5432/smartcampus
# Rôle propriétaire (DDL), migrations Alembic en synchrone (psycopg 3).
MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5432/smartcampus
# Rôle lecture seule de l'outil RAG (E4).
RAG_READER_DATABASE_URL=postgresql+asyncpg://smartcampus_rag_reader:change_me_rag@localhost:5432/smartcampus

# Base de test (service db-test, port 5433) : tests pytest marqués « db ».
TEST_DATABASE_URL=postgresql+asyncpg://smartcampus_app:change_me_app@localhost:5433/smartcampus_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://smartcampus_owner:change_me_owner@localhost:5433/smartcampus_test

# Facultatif : surcharge des origines CORS (liste JSON) et du niveau de journal.
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=DEBUG
