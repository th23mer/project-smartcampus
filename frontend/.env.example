# Configuration du frontend SmartCampus AI (copier en .env.local).
# Toutes les variables NEXT_PUBLIC_* sont visibles dans le navigateur : AUCUN secret ici.

# Adresse du backend FastAPI (sans /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# dev | test | staging | prod. En "dev" seulement : sélecteur de rôle et en-têtes X-Dev-User-Id / X-Dev-Roles.
NEXT_PUBLIC_APP_ENV=dev

# false (défaut) : le chat appelle l'API réelle (session visiteur + conversation, E3) ;
# true : faux flux SSE local (démonstration de l'interface sans backend).
NEXT_PUBLIC_CHAT_MOCK=false
